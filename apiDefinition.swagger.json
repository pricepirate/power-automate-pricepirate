{
  "swagger": "2.0",
  "info": {
    "title": "PricePirate Price Data",
    "description": "PricePirate Price Data looks up live marketplace prices by EAN, GTIN or marketplace product ID across European and international marketplaces and price comparison sites. Get every offer with shop, price, shipping and availability, or product details with the lowest, average and highest price. Each query costs one credit, and new accounts get 100 free credits.",
    "version": "1.0.0",
    "contact": {
      "name": "UCX Media support",
      "url": "https://pricepirate.com/docs/en/guide/help/support",
      "email": "info@gaponik.com"
    }
  },
  "host": "api-v2.pricepirate.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "x-ms-connector-metadata": [
    {
      "propertyName": "Website",
      "propertyValue": "https://pricepirate.com/en/price-api/"
    },
    {
      "propertyName": "Privacy policy",
      "propertyValue": "https://pricepirate.com/en/legal/privacy"
    },
    {
      "propertyName": "Categories",
      "propertyValue": "Data;Commerce"
    }
  ],
  "x-ms-capabilities": {
    "testConnection": {
      "operationId": "GetAccount",
      "parameters": {}
    }
  },
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "in": "header",
      "name": "x-api-key"
    }
  },
  "security": [
    {
      "api_key": []
    }
  ],
  "paths": {
    "/api/v2/jobs/offers": {
      "post": {
        "operationId": "GetOffers",
        "summary": "Get offers by EAN or product ID",
        "description": "Looks up every offer for each EAN or product ID on the chosen marketplace and waits until the price job is finished. Returns one item per offer, and one item for each query without offers.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "$ref": "#/parameters/marketplace"
          },
          {
            "$ref": "#/parameters/country"
          },
          {
            "$ref": "#/parameters/search_by"
          },
          {
            "$ref": "#/parameters/queries"
          },
          {
            "$ref": "#/parameters/skip_empty"
          },
          {
            "$ref": "#/parameters/include_details"
          },
          {
            "$ref": "#/parameters/zipcode"
          }
        ],
        "responses": {
          "200": {
            "description": "The finished price job with one item per offer.",
            "schema": {
              "$ref": "#/definitions/OffersResult"
            }
          },
          "202": {
            "$ref": "#/responses/JobPending"
          }
        }
      }
    },
    "/api/v2/jobs/details": {
      "post": {
        "operationId": "GetProductDetails",
        "summary": "Get product details by EAN or product ID",
        "description": "Looks up product details for each EAN or product ID on the chosen marketplace and waits until the price job is finished. Returns one item per query with the lowest, average and highest price.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "$ref": "#/parameters/marketplace"
          },
          {
            "$ref": "#/parameters/country"
          },
          {
            "$ref": "#/parameters/search_by"
          },
          {
            "$ref": "#/parameters/queries"
          },
          {
            "$ref": "#/parameters/skip_empty_products"
          },
          {
            "$ref": "#/parameters/include_details"
          },
          {
            "$ref": "#/parameters/zipcode"
          }
        ],
        "responses": {
          "200": {
            "description": "The finished price job with one item per query.",
            "schema": {
              "$ref": "#/definitions/ProductDetailsResult"
            }
          },
          "202": {
            "$ref": "#/responses/JobPending"
          }
        }
      }
    },
    "/api/v2/jobs/start": {
      "post": {
        "operationId": "StartPriceJob",
        "summary": "Start price job",
        "description": "Starts a price job and returns its job ID right away without waiting. Use Get job results within about 1 hour after the job finishes to read the results.",
        "x-ms-visibility": "advanced",
        "parameters": [
          {
            "$ref": "#/parameters/marketplace"
          },
          {
            "$ref": "#/parameters/country"
          },
          {
            "$ref": "#/parameters/search_by"
          },
          {
            "$ref": "#/parameters/queries"
          },
          {
            "$ref": "#/parameters/include_details"
          },
          {
            "$ref": "#/parameters/zipcode"
          }
        ],
        "responses": {
          "200": {
            "description": "The price job was started.",
            "schema": {
              "$ref": "#/definitions/StartedJob"
            }
          }
        }
      }
    },
    "/api/v2/jobs/{jobId}/results": {
      "get": {
        "operationId": "GetJobResults",
        "summary": "Get job results",
        "description": "Reads the results of a price job as offers, product details or the raw job JSON. Results are kept for about 1 hour after the job finishes.",
        "x-ms-visibility": "advanced",
        "parameters": [
          {
            "$ref": "#/parameters/jobId"
          },
          {
            "name": "output",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "offers",
            "enum": [
              "offers",
              "details",
              "raw"
            ],
            "x-ms-enum-values": [
              {
                "value": "offers",
                "displayName": "Offers (one item per offer)"
              },
              {
                "value": "details",
                "displayName": "Product details (one item per query)"
              },
              {
                "value": "raw",
                "displayName": "Raw job JSON"
              }
            ],
            "x-ms-summary": "Output",
            "description": "Choose whether to return offers, product details or the unchanged job JSON."
          },
          {
            "name": "wait",
            "in": "query",
            "required": false,
            "type": "boolean",
            "default": true,
            "x-ms-summary": "Wait until finished",
            "description": "When this is Yes, the action waits until the job is finished. When this is No, a pending job is returned right away with its progress."
          },
          {
            "$ref": "#/parameters/skip_empty"
          }
        ],
        "responses": {
          "200": {
            "description": "The price job with its results.",
            "schema": {
              "$ref": "#/definitions/JobResults"
            }
          },
          "202": {
            "$ref": "#/responses/JobPending"
          }
        }
      }
    },
    "/api/v2/jobs/{jobId}": {
      "get": {
        "operationId": "PollJob",
        "summary": "Poll price job",
        "description": "Checks a price job while the platform waits for it to finish. This operation is used internally by the connector.",
        "x-ms-visibility": "internal",
        "parameters": [
          {
            "$ref": "#/parameters/jobId"
          },
          {
            "name": "view",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-visibility": "internal",
            "x-ms-summary": "View",
            "description": "The output shape that the connector returns when the job is finished."
          },
          {
            "name": "skip_empty",
            "in": "query",
            "required": false,
            "type": "boolean",
            "x-ms-visibility": "internal",
            "x-ms-summary": "Skip queries without results",
            "description": "Whether queries without results are left out of the output."
          }
        ],
        "responses": {
          "200": {
            "description": "The finished price job.",
            "schema": {
              "$ref": "#/definitions/JobResults"
            }
          },
          "202": {
            "$ref": "#/responses/JobPending"
          }
        }
      }
    },
    "/api/v2/account": {
      "get": {
        "operationId": "GetAccount",
        "summary": "Get account",
        "description": "Returns the credit balance, limits and available marketplaces of the account that owns the API key.",
        "x-ms-visibility": "advanced",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The account.",
            "schema": {
              "$ref": "#/definitions/Account"
            }
          }
        }
      }
    },
    "/pricepirate/countries": {
      "get": {
        "operationId": "ListCountries",
        "summary": "List countries",
        "description": "Lists the countries that are available for a marketplace. This operation is used internally by the connector.",
        "x-ms-visibility": "internal",
        "parameters": [
          {
            "name": "marketplace",
            "in": "query",
            "required": true,
            "type": "string",
            "x-ms-summary": "Marketplace",
            "description": "The marketplace whose countries are listed."
          }
        ],
        "responses": {
          "200": {
            "description": "The countries of the marketplace.",
            "schema": {
              "type": "object",
              "properties": {
                "countries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "x-ms-summary": "Country code",
                        "description": "The two-letter country code."
                      },
                      "name": {
                        "type": "string",
                        "x-ms-summary": "Country name",
                        "description": "The English country name."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "parameters": {
    "marketplace": {
      "name": "marketplace",
      "in": "query",
      "required": true,
      "type": "string",
      "enum": [
        "idealo",
