        "value-path": "code",
        "value-title": "name",
        "parameters": {
          "marketplace": {
            "parameter": "marketplace"
          }
        }
      }
    },
    "search_by": {
      "name": "search_by",
      "in": "query",
      "required": false,
      "type": "string",
      "default": "ean",
      "enum": [
        "ean",
        "product_id"
      ],
      "x-ms-enum-values": [
        {
          "value": "ean",
          "displayName": "EAN or GTIN"
        },
        {
          "value": "product_id",
          "displayName": "Marketplace product ID (ASIN on Amazon)"
        }
      ],
      "x-ms-summary": "Search by",
      "description": "Choose whether the queries are EANs or GTINs, or product IDs of the marketplace. Klarna and PriceRunner only support EANs."
    },
    "queries": {
      "name": "body",
      "in": "body",
      "required": true,
      "schema": {
        "type": "object",
        "required": [
          "queries"
        ],
        "properties": {
          "queries": {
            "type": "array",
            "x-ms-summary": "Queries",
            "description": "The EANs, GTINs or product IDs to look up, from 1 to 1000. Each query costs one credit.",
            "items": {
              "type": "string",
              "x-ms-summary": "Query",
              "description": "One EAN, GTIN or product ID."
            }
          }
        }
      }
    },
    "skip_empty": {
      "name": "skip_empty",
      "in": "query",
      "required": false,
      "type": "boolean",
      "default": false,
      "x-ms-visibility": "advanced",
      "x-ms-summary": "Skip queries without offers",
      "description": "When this is Yes, queries that found no offers or failed are left out. By default they appear as one item each with their status."
    },
    "skip_empty_products": {
      "name": "skip_empty",
      "in": "query",
      "required": false,
      "type": "boolean",
      "default": false,
      "x-ms-visibility": "advanced",
      "x-ms-summary": "Skip queries without a product",
      "description": "When this is Yes, queries that found no product or failed are left out. By default they appear as one item each with their status."
    },
    "include_details": {
      "name": "include_details",
      "in": "query",
      "required": false,
      "type": "boolean",
      "default": true,
      "x-ms-visibility": "advanced",
      "x-ms-summary": "Include product details (Amazon only)",
      "description": "For Amazon only. When this is No, the product detail lookup is skipped and only offers are returned."
    },
    "zipcode": {
      "name": "zipcode",
      "in": "query",
      "required": false,
      "type": "string",
      "x-ms-visibility": "advanced",
      "x-ms-summary": "Delivery postal code (Amazon only)",
      "description": "For Amazon only. The postal code that delivery prices and availability are calculated for."
    },
    "jobId": {
      "name": "jobId",
      "in": "path",
      "required": true,
      "type": "string",
      "x-ms-url-encoding": "single",
      "x-ms-summary": "Job ID",
      "description": "The ID of the price job."
    }
  },
  "responses": {
